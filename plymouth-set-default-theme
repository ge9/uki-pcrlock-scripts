#!/bin/sh
# place this in one of the directories in DRACUT_PATH (usually, `/sbin /bin /usr/sbin /usr/bin`)
# a stub for Debian-based distros
case "${1:-}" in
  --list)
    for d in /usr/share/plymouth/themes/*/; do
      basename "$d"
    done
    exit 0
    ;;
  "")
    ;;
  *)
    exit 0
    ;;
esac

theme=$(sed -n 's/^Theme=//p' /etc/plymouth/plymouthd.conf 2>/dev/null | tail -n1)
if [ -z "$theme" ]; then
  link=$(readlink -f /usr/share/plymouth/themes/default.plymouth 2>/dev/null) &&
    theme=$(basename "$(dirname "$link")")
fi
echo "${theme:-text}"